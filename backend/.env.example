# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cognicare
PG_POOL_MAX=10

# Long random string. Rotating it signs everybody out immediately.
JWT_SECRET=change-me-to-at-least-32-random-bytes
JWT_ISSUER=cognicare

# Short on purpose: guards re-read the database, but the token itself is the
# window during which a stolen one still works.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

EMAIL_VERIFY_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# Comma-separated. Leave unset to allow any origin (development only).
CORS_ORIGIN=

# OpenRouter, for the AI remarks and the chatbot. Server-side only — the app
# never sees this key, because an Expo bundle is readable and a key shipped
# inside it is a public key. Leave unset to disable the AI features; the rest
# of the API works without it.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Used once by `npm run seed:admin`, then remove them.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
